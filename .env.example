# ==============================================
# Biblebot 环境变量配置模板
# 复制为 .env 并填入你的 API Key
# cp .env.example .env
# ==============================================

# --- Qdrant 向量数据库 ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=kb_hybrid

# --- LLM（DeepSeek, 用于查询改写） ---
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- 词嵌入（硅基流动 API） ---
USE_EMBEDDING_API=True
EMBEDDING_API_KEY=sk-your-siliconflow-api-key
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=4096

# --- 重排序（硅基流动 API） ---
RERANK_API_KEY=sk-your-siliconflow-api-key
RERANK_API_URL=https://api.siliconflow.cn/v1/rerank

# --- 路径配置 ---
KNOWLEDGE_BASE_PATH=data/canonical_md
DATA_RAW_DIR=data/raw
DATA_CANONICAL_DIR=data/canonical_md

# --- Claude CLI Agent 认证 ---
# 在 Anthropic Console 生成: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# --- MCP 服务器配置（可选） ---
# 推荐方式: 复制模板编辑后指定路径
#   cp mcp_config.json.example mcp_config.json
#   # 编辑 mcp_config.json 填入你的 MCP 服务器配置
MCP_CONFIG_PATH=mcp_config.json

# 高级方式: 直接写 JSON 字符串（优先级高于 MCP_CONFIG_PATH）
# 注意: JSON 内不要换行，否则 .env 解析会截断
# MCP_CONFIG_JSON={"mcpServers":{"name":{"command":"...","args":[...]}}}
